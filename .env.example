# =========================================================
# MaxTracker — variables de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.
# =========================================================

# ---------------------------------------------------------
# Backend (Spring Boot) — en uso desde el Día 1
# ---------------------------------------------------------
# Puerto HTTP (Render lo define automáticamente)
PORT=8080

# Orígenes permitidos por CORS, separados por coma (sin "/" final)
# Ej. producción: https://maxtracker.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# API pública de wger (catálogo de ejercicios)
WGER_BASE_URL=https://wger.de/api/v2/
# IDs de idioma en wger: 4 = español, 2 = inglés (respaldo)
WGER_IDIOMA_ESPANOL=4
WGER_IDIOMA_RESPALDO=2

# ---------------------------------------------------------
# Base de datos (Supabase, Session pooler) — Día 2
# ---------------------------------------------------------
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=

# ---------------------------------------------------------
# Seguridad (JWT) — Día 3
# ---------------------------------------------------------
# JWT_SECRET=<cadena aleatoria de al menos 32 bytes>
# JWT_EXPIRATION=PT12H
# APP_USER_EMAIL=
# APP_USER_PASSWORD=

# ---------------------------------------------------------
# Análisis con IA (Groq / Gemini) — Día 7
# ---------------------------------------------------------
# GROQ_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------
# Frontend (Vite) — Día 4
# Va en maxtracker-frontend/.env (Vite solo expone variables VITE_*)
# ---------------------------------------------------------
# VITE_API_URL=http://localhost:8080
