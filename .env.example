# =========================================================
# MaxTracker — variables de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.
# =========================================================

# ---------------------------------------------------------
# Backend (Spring Boot) — en uso desde el Día 1
# ---------------------------------------------------------
# Puerto HTTP (Render lo define automáticamente)
PORT=8080

# Orígenes permitidos por CORS, separados por coma (sin "/" final)
# Ej. producción: https://maxtracker.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# API pública de wger (catálogo de ejercicios)
WGER_BASE_URL=https://wger.de/api/v2/
# IDs de idioma en wger: 4 = español, 2 = inglés (respaldo)
WGER_IDIOMA_ESPANOL=4
WGER_IDIOMA_RESPALDO=2

# ---------------------------------------------------------
# Base de datos (Supabase, Session pooler IPv4, puerto 5432) — en uso desde el Día 2
# Supabase > Project Settings > Database > Connection string > Session pooler (formato JDBC)
# ---------------------------------------------------------
DB_URL=jdbc:postgresql://aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
# Conexiones simultáneas del backend (el plan gratuito tiene un límite bajo)
DB_POOL_SIZE=5

# ---------------------------------------------------------
# Seguridad (JWT) — en uso desde el Día 3
# ---------------------------------------------------------
# Clave de firma HS256, al menos 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=
# Vigencia del token (ISO-8601)
JWT_EXPIRATION=PT12H
# Permite crear cuentas con POST /api/v1/auth/register; poner en false tras crear la tuya
AUTH_REGISTRO_HABILITADO=true

# Zona horaria del usuario: fecha "de hoy" al iniciar una sesion sin fecha (IANA)
APP_ZONA_HORARIA=America/Santiago

# ---------------------------------------------------------
# Análisis con IA (Gemini) — Día 7
# Clave gratuita en https://aistudio.google.com/apikey (solo en el backend, nunca en el frontend).
# Sin clave, la app funciona igual y el análisis responde 503.
# Plan gratuito: Google puede usar los datos enviados para mejorar sus productos. Solo se envían
# ejercicios, fechas, pesos, repeticiones y RIR (nunca el email ni datos de la cuenta).
# ---------------------------------------------------------
GEMINI_API_KEY=
# Modelo con plan gratuito (ver https://ai.google.dev/pricing); cambiarlo si Google lo retira
GEMINI_MODEL=gemini-3.5-flash-lite
# Intervalo mínimo entre análisis de un mismo usuario (ISO-8601)
ANALISIS_INTERVALO_MINIMO=PT20S

# ---------------------------------------------------------
# Frontend (Vite) — Día 4
# Va en maxtracker-frontend/.env (Vite solo expone variables VITE_*)
# ---------------------------------------------------------
# URL base de la API, terminada en /api/v1 (sin "/" final)
# Ej. producción: https://<tu-servicio>.onrender.com/api/v1
# VITE_API_URL=http://localhost:8080/api/v1
